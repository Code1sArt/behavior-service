DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
JWT_SECRET="change-me"
PORT=3000

LINE_CHANNEL_ACCESS_TOKEN=""
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# Server-side deploy script options:
# DEPLOY_DATABASE_MODE=migrate | push | skip
DEPLOY_DATABASE_MODE=migrate

# prepare = install/generate/migrate only, without rebuilding or restarting
# release = complete the deployment and restart the application
DEPLOY_APP_MODE=release

# Optional when the app is managed by PM2 instead of Plesk Passenger:
# APP_PM2_NAME=behavior-service

# Optional when SSH sessions do not load the Plesk Node.js path:
# NODE_BIN_DIR=/opt/plesk/node/24/bin

# Enable only after deploying 20261019110000_notification_inbox
IN_APP_NOTIFICATIONS_ENABLED=false

# Staff email/password + OTP for the native app; web/LINE login stays unchanged.
STAFF_EMAIL_OTP_ENABLED=false
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
# Generate a separate random secret of at least 32 characters; server only.
STAFF_OTP_SECRET=""
# Conservative rolling 24-hour cap, shared by all backend processes (max 300).
STAFF_OTP_DAILY_LIMIT=280
